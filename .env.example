# ============================================================
# Recommendarr — Configuration
# Copy to .env and fill in your values
# ============================================================

# ── Required ─────────────────────────────────────────────────

# Plex — how the backend connects to your Plex server
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your-plex-token-here
# Get your Plex token: https://support.plex.tv/articles/204059436

# Tautulli — watch history source
TAUTULLI_URL=http://localhost:8181
TAUTULLI_API_KEY=your-tautulli-api-key

# TMDB — metadata (free key from themoviedb.org)
TMDB_API_KEY=your-tmdb-api-key

# ── Library Management (at least one Radarr/Sonarr) ─────────

# Radarr — movies
RADARR_URL=http://localhost:7878
RADARR_API_KEY=your-radarr-api-key

# Sonarr — TV shows
SONARR_URL=http://localhost:8989
SONARR_API_KEY=your-sonarr-api-key

# Sonarr Anime — separate instance (optional)
# SONARR_ANIME_URL=http://localhost:8990
# SONARR_ANIME_API_KEY=your-sonarr-anime-api-key

# ── Optional: Seerr (fallback metadata source) ──────────────
# SEERR_URL=http://localhost:5055
# SEERR_API_KEY=your-seerr-api-key

# ── Optional: AI Features ────────────────────────────────────
# Configure in the web UI under Settings > AI Configuration
# Or set here for automated deployments:

# LLM_BASE_URL=http://localhost:11434     # Ollama endpoint
# CHROMADB_URL=http://localhost:8000       # ChromaDB for RAG sync
# EMBEDDING_MODEL=nomic-embed-text         # Embedding model name

# ── Optional: External Plex URL ──────────────────────────────
# URL your users see (for "Play in Plex" links)
# Default: uses app.plex.tv deep links (works everywhere)
# PLEX_EXTERNAL_URL=https://plex.example.com

# ── App Settings ─────────────────────────────────────────────
# RECOMMENDARR_PORT=5055                   # Internal port (default: 5055)
# JWT_SECRET=change-me-in-production       # Auto-generated if empty
# JWT_EXPIRY_HOURS=720                     # Token lifetime (30 days)
# DEBUG=false                              # Enable /api/docs
# LOG_LEVEL=info                           # debug | info | warning | error
# TZ=UTC                                   # Timezone
