# ═══════════════════════════════════════════════════════════════
# RECOMMENDARR — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Required fields are marked with [REQUIRED].

# ── Plex [REQUIRED] ────────────────────────────────────────────
PLEX_URL=http://localhost:32400
PLEX_TOKEN=                                   # [REQUIRED] Admin Plex token
PLEX_MACHINE_ID=                              # [REQUIRED] Server machine ID (Settings → General → click "Show Advanced")

# ── Tautulli [REQUIRED] ────────────────────────────────────────
TAUTULLI_URL=http://localhost:8181
TAUTULLI_API_KEY=                             # [REQUIRED] Settings → Web Interface → API Key

# ── TMDB [REQUIRED] ────────────────────────────────────────────
TMDB_API_KEY=                                 # [REQUIRED] Free key from themoviedb.org/settings/api

# ── Radarr (required for movie recommendations) ────────────────
RADARR_URL=http://localhost:7878
RADARR_API_KEY=                               # Settings → General → API Key

# ── Sonarr (required for TV recommendations) ────────────────────
SONARR_URL=http://localhost:8989
SONARR_API_KEY=                               # Settings → General → API Key
SONARR_ANIME_URL=                             # Optional: separate Sonarr instance for anime
SONARR_ANIME_API_KEY=

# ── Seerr/Overseerr (required for discovery + requests) ────────
SEERR_URL=http://localhost:5055
SEERR_API_KEY=                                # Settings → General → API Key

# ── Authentication ──────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-string       # [REQUIRED] openssl rand -hex 32

# ── LLM Integration (optional) ─────────────────────────────────
# Leave empty to use template-based explanations (no LLM needed).
LLM_BASE_URL=                                 # OpenAI-compatible endpoint (e.g., http://localhost:11434 for Ollama)
CHROMADB_URL=                                 # ChromaDB for semantic search (e.g., http://localhost:8000)
EMBEDDING_MODEL=nomic-embed-text              # Ollama embedding model name

# ── Application ─────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=info                                # debug | info | warning | error
RECOMMENDARR_PORT=30800                       # Backend API port
