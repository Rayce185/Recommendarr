<?xml version="1.0"?>
<Container version="2">
  <Name>Recommendarr</Name>
  <Repository>rayce185/recommendarr:latest</Repository>
  <Registry>https://hub.docker.com/r/rayce185/recommendarr</Registry>
  <Branch>
    <Tag>latest</Tag>
    <TagDescription>Latest stable release</TagDescription>
  </Branch>
  <Branch>
    <Tag>1.0.0</Tag>
    <TagDescription>v1.0.0 Initial release</TagDescription>
  </Branch>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Rayce185/Recommendarr/issues</Support>
  <Project>https://github.com/Rayce185/Recommendarr</Project>
  <Overview>Self-hosted media recommendation engine for Plex. Learns from viewing behavior across all server users to generate personalized, explainable recommendations. Features 6 recommendation modes (Watch Tonight, Mood Match, Group Night, Discovery Feed, and more), collection tracking, world cinema discovery, taste profiles, friend system, and optional AI-powered explanations via local LLM. Integrates with Plex, Tautulli, Radarr, Sonarr, Seerr, and TMDB.</Overview>
  <Category>MediaServer:Other Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT:5055]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/Rayce185/Recommendarr/main/unraid-template.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/Rayce185/Recommendarr/main/logo.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <DateInstalled/>
  <Description>Self-hosted media recommendation engine for Plex. Learns from viewing behavior across all server users to generate personalized, explainable recommendations.</Description>
  <Networking>
    <Mode>bridge</Mode>
    <Publish>
      <Port>
        <HostPort>5055</HostPort>
        <ContainerPort>5055</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Data>
    <Volume>
      <HostDir>/mnt/user/appdata/recommendarr</HostDir>
      <ContainerDir>/app/data</ContainerDir>
      <Mode>rw</Mode>
    </Volume>
  </Data>
  <Environment>
    <Variable>
      <Value>http://your-plex:32400</Value>
      <Name>PLEX_URL</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value/>
      <Name>PLEX_TOKEN</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>http://your-tautulli:8181</Value>
      <Name>TAUTULLI_URL</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value/>
      <Name>TAUTULLI_API_KEY</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value/>
      <Name>TMDB_API_KEY</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>http://your-radarr:7878</Value>
      <Name>RADARR_URL</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value/>
      <Name>RADARR_API_KEY</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>http://your-sonarr:8989</Value>
      <Name>SONARR_URL</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value/>
      <Name>SONARR_API_KEY</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>http://your-sonarr-anime:8990</Value>
      <n>SONARR_ANIME_URL</n>
      <Mode/>
    </Variable>
    <Variable>
      <Value/>
      <n>SONARR_ANIME_API_KEY</n>
      <Mode/>
    </Variable>
    <Variable>
      <Value>http://your-seerr:5055</Value>
      <Name>SEERR_URL</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value/>
      <Name>SEERR_API_KEY</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>America/New_York</Value>
      <Name>TZ</Name>
      <Mode/>
    </Variable>
  </Environment>
  <Labels/>
  <Config Name="WebUI Port" Target="5055" Default="5055" Mode="tcp" Description="Web interface port" Type="Port" Display="always" Required="true" Mask="false">5055</Config>
  <Config Name="Data Directory" Target="/app/data" Default="/mnt/user/appdata/recommendarr" Mode="rw" Description="Persistent data storage" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/recommendarr</Config>
  <Config Name="Plex URL" Target="PLEX_URL" Default="http://your-plex:32400" Mode="" Description="URL of your Plex server" Type="Variable" Display="always" Required="true" Mask="false">http://your-plex:32400</Config>
  <Config Name="Plex Token" Target="PLEX_TOKEN" Default="" Mode="" Description="Plex authentication token" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Tautulli URL" Target="TAUTULLI_URL" Default="http://your-tautulli:8181" Mode="" Description="URL of your Tautulli instance" Type="Variable" Display="always" Required="true" Mask="false">http://your-tautulli:8181</Config>
  <Config Name="Tautulli API Key" Target="TAUTULLI_API_KEY" Default="" Mode="" Description="Tautulli API key" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="TMDB API Key" Target="TMDB_API_KEY" Default="" Mode="" Description="TMDB API key (get one at themoviedb.org)" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Radarr URL" Target="RADARR_URL" Default="http://your-radarr:7878" Mode="" Description="URL of your Radarr instance (optional)" Type="Variable" Display="always" Required="false" Mask="false">http://your-radarr:7878</Config>
  <Config Name="Radarr API Key" Target="RADARR_API_KEY" Default="" Mode="" Description="Radarr API key (optional)" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Sonarr URL" Target="SONARR_URL" Default="http://your-sonarr:8989" Mode="" Description="URL of your Sonarr instance (optional)" Type="Variable" Display="always" Required="false" Mask="false">http://your-sonarr:8989</Config>
  <Config Name="Sonarr API Key" Target="SONARR_API_KEY" Default="" Mode="" Description="Sonarr API key (optional)" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Seerr URL" Target="SEERR_URL" Default="http://your-seerr:5055" Mode="" Description="URL of your Overseerr/Jellyseerr instance (optional)" Type="Variable" Display="always" Required="false" Mask="false">http://your-seerr:5055</Config>
  <Config Name="Seerr API Key" Target="SEERR_API_KEY" Default="" Mode="" Description="Seerr API key (optional)" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Sonarr Anime URL" Target="SONARR_ANIME_URL" Default="http://your-sonarr-anime:8990" Mode="" Description="URL of separate Sonarr instance for anime (optional)" Type="Variable" Display="always" Required="false" Mask="false">http://your-sonarr-anime:8990</Config>
  <Config Name="Sonarr Anime API Key" Target="SONARR_ANIME_API_KEY" Default="" Mode="" Description="Anime Sonarr API key (optional)" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="LLM Endpoint" Target="LLM_BASE_URL" Default="" Mode="" Description="Ollama-compatible API endpoint for AI explanations (optional, e.g. http://your-ollama:11434)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="LLM Model" Target="LLM_MODEL" Default="" Mode="" Description="LLM model name for AI explanations (optional, e.g. llama3:8b)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Timezone" Target="TZ" Default="America/New_York" Mode="" Description="Container timezone" Type="Variable" Display="always" Required="false" Mask="false">America/New_York</Config>
</Container>
