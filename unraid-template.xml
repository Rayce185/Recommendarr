<?xml version="1.0"?>
<Container version="2">
  <Name>Recommendarr</Name>
  <Repository>rayce185/recommendarr</Repository>
  <Registry>https://hub.docker.com/r/rayce185/recommendarr</Registry>
  <Branch>
    <Tag>latest</Tag>
    <TagDescription>Latest stable release</TagDescription>
  </Branch>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Rayce185/Recommendarr/issues</Support>
  <Project>https://github.com/Rayce185/Recommendarr</Project>
  <Overview>
    Self-hosted media recommendation engine for Plex. Learns from viewing behavior across all server users to generate personalized, explainable recommendations.

    Features: 5 recommendation modes (Watch Tonight, Worth Grabbing, Rediscover, Mood Match, Group Night), optional AI-powered explanations via Ollama/OpenAI/Anthropic, smart mood matching, multi-source trending, collection tracking, Plex Wrapped stats, social taste overlap, and more.

    Requires: Plex, Tautulli, at least one of Radarr/Sonarr, Seerr/Overseerr, and a free TMDB API key.
  </Overview>
  <Category>MediaApp:Other</Category>
  <WebUI>http://[IP]:[PORT:5055]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/Rayce185/Recommendarr/main/unraid-template.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/Rayce185/Recommendarr/main/icon.svg</Icon>
  <ExtraParams/>
  <DateInstalled/>
  <Description>
    Self-hosted media recommendation engine for Plex. Learns from viewing behavior across all server users to generate personalized, explainable recommendations with optional AI enhancement.
  </Description>
  <Config Name="Web UI Port" Target="5055" Default="5055" Mode="tcp" Description="Web interface and API port" Type="Port" Display="always" Required="true" Mask="false">5055</Config>
  <Config Name="Data Directory" Target="/app/data" Default="/mnt/user/appdata/recommendarr" Mode="rw" Description="Persistent data (SQLite DB, caches)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/recommendarr</Config>
  <Config Name="Timezone" Target="TZ" Default="America/New_York" Mode="" Description="Container timezone" Type="Variable" Display="always" Required="false" Mask="false">America/New_York</Config>
  <Config Name="Plex URL" Target="PLEX_URL" Default="http://192.168.1.x:32400" Mode="" Description="Plex server URL" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Plex Token" Target="PLEX_TOKEN" Default="" Mode="" Description="Plex authentication token" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Tautulli URL" Target="TAUTULLI_URL" Default="http://192.168.1.x:8181" Mode="" Description="Tautulli URL for watch history" Type="Variable" Display="always" Required="true" Mask="false"/>
  <Config Name="Tautulli API Key" Target="TAUTULLI_API_KEY" Default="" Mode="" Description="Tautulli API key" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="TMDB API Key" Target="TMDB_API_KEY" Default="" Mode="" Description="Free API key from themoviedb.org" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Radarr URL" Target="RADARR_URL" Default="http://192.168.1.x:7878" Mode="" Description="Radarr URL (movies)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Radarr API Key" Target="RADARR_API_KEY" Default="" Mode="" Description="Radarr API key" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Sonarr URL" Target="SONARR_URL" Default="http://192.168.1.x:8989" Mode="" Description="Sonarr URL (TV shows)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Sonarr API Key" Target="SONARR_API_KEY" Default="" Mode="" Description="Sonarr API key" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="Seerr URL" Target="SEERR_URL" Default="http://192.168.1.x:5055" Mode="" Description="Seerr/Overseerr URL" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="Seerr API Key" Target="SEERR_API_KEY" Default="" Mode="" Description="Seerr/Overseerr API key" Type="Variable" Display="always" Required="false" Mask="true"/>
</Container>
